# Copy to .env and fill in real values before running `docker compose up`.
# Secrets for the local test lldap directory (docker/lldap). See
# https://github.com/lldap/lldap for details on each variable.

# Generate with:
#   LC_ALL=C tr -dc 'A-Za-z0-9!#%&()*+,-./:;<=>?@[]^_{|}~' </dev/urandom | head -c 32
LLDAP_JWT_SECRET=REPLACE_WITH_RANDOM

# Generate with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24
LLDAP_KEY_SEED=REPLACE_WITH_RANDOM

# Password for the lldap admin account (cn=admin,ou=people,dc=example,dc=com).
# Minimum 8 characters.
LLDAP_LDAP_USER_PASS=CHANGE_ME
